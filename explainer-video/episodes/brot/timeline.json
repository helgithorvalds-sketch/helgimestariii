   "take": "e2-25391fa7bf.mp3"
  },
  {
   "id": "e3",
   "part": "4 Erfiða skrefið",
   "text": "En prófum þetta.",
   "start": 35.43,
   "end": 36.39,
   "take": "e3-df014de645.mp3"
  },
  {
   "id": "e4",
   "part": "4 Erfiða skrefið",
   "text": "Fjórir vinir skipta einni plötu.",
   "start": 36.84,
   "end": 39.0,
   "take": "e4-a63b003d13.mp3"
  },
  {
   "id": "e5",
   "part": "4 Erfiða skrefið",
   "text": "Hver fær einn fjórða.",
