   "end": 64.674,
   "take": "e11-2491d8a942.mp3"
  },
  {
   "id": "e12",
   "part": "4 Erfiða skrefið",
   "text": "Því fleiri sem skipta, því minni verða bitarnir.",
   "start": 65.124,
