  },
  {
   "id": "h1",
   "part": "3 Hittu hlutana",
   "text": "Sjáðu, brot er bara tvær tölur.",
   "start": 16.709,
   "end": 19.49,
   "take": "h1-c06b755bc7.mp3"
  },
  {
   "id": "h2",
   "part": "3 Hittu hlutana",
   "text": "Ein er uppi og ein er niðri.",
   "start": 19.94,
   "end": 22.239,
   "take": "h2-9a0b16a5a1.mp3"
  },
  {
   "id": "h3",
   "part": "3 Hittu hlutana",
   "text": "Talan niðri heitir nefnari.",
   "start": 22.689,
   "end": 24.989,
   "take": "h3-0b8063830f.mp3"
  },
  {
   "id": "h4",
   "part": "3 Hittu hlutana",
   "text": "Hún segir hvað bitarnir eru margir.",
   "start": 25.439,
   "end": 28.099,
   "take": "h4-8309ea83e1.mp3"
  },
  {
   "id": "h5",
   "part": "3 Hittu hlutana",
   "text": "Talan uppi heitir teljari.",
   "start": 28.549,
   "end": 30.851,
   "take": "h5-2e23c771c9.mp3"
  },
  {
   "id": "h6",
   "part": "3 Hittu hlutana",
   "text": "Hún segir hvað þú færð marga bita.",
   "start": 31.301,
   "end": 33.781,
   "take": "h6-868d615849.mp3"
  },
  {
   "id": "e1",
   "part": "4 Erfiða skrefið",
   "text": "Margir velja einn áttunda.",
   "start": 35.031,
   "end": 37.061,
   "take": "e1-2a7d94f31e.mp3"
  },
  {
   "id": "e2",
   "part": "4 Erfiða skrefið",
   "text": "Af því að átta er meira en fjórir.",
   "start": 37.511,
   "end": 40.418,
   "take": "e2-4bc04ea172.mp3"
  },
  {
   "id": "e3",
   "part": "4 Erfiða skrefið",
   "text": "En prófum þetta.",
   "start": 40.868,
   "end": 42.066,
   "take": "e3-7988b22a0f.mp3"
  },
  {
   "id": "e4",
   "part": "4 Erfiða skrefið",
   "text": "Fjórir vinir skipta einni plötu.",
   "start": 42.516,
   "end": 45.083,
   "take": "e4-54ed219541.mp3"
  },
  {
   "id": "e5",
   "part": "4 Erfiða skrefið",
   "text": "Hver fær einn fjórða.",
   "start": 45.533,
   "end": 47.285,
   "take": "e5-8f66f2eb34.mp3"
  },
  {
   "id": "e6",
   "part": "4 Erfiða skrefið",
   "text": "Svo koma fjórir í viðbót.",
   "start": 47.735,
   "end": 49.735,
   "take": "e6-223c1b0bd0.mp3"
  },
  {
   "id": "e7",
   "part": "4 Erfiða skrefið",
   "text": "Nú eru þeir átta, en platan er jafn stór.",
   "start": 50.185,
   "end": 53.248,
   "take": "e7-d6f5ad64f0.mp3"
  },
  {
   "id": "e8",
   "part": "4 Erfiða skrefið",
   "text": "Þá þarf að skipta henni í átta bita.",
