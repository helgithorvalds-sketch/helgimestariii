   "end": 99.142,
   "take": "r1-c5f0050b55.wav"
  },
  {
   "id": "r2",
   "part": "6 Reglan og annað dæmi",
   "text": "Því stærri sem nefnarinn er, því minni er hver hluti.",
   "start": 99.592,
   "end": 103.247,
   "take": "r2-f7dd5fb6df.wav"
  },
  {
   "id": "r3",
   "part": "6 Reglan og annað dæmi",
   "text": "Hún gildir um allt sem við skiptum, líka um pítsu.",
   "start": 103.697,
   "end": 106.507,
   "take": "r3-21699856a6.wav"
  },
  {
   "id": "r4",
   "part": "6 Reglan og annað dæmi",
   "text": "Ef tveir deila pítsu fær hvor um sig helminginn.",
