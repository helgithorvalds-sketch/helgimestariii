   "end": 113.275,
   "take": "r5-13612e6587.wav"
  },
  {
   "id": "r6",
   "part": "6 Reglan og annað dæmi",
   "text": "Súkkulaði eða pítsa, það er sama reglan.",
   "start": 113.725,
   "end": 116.814,
   "take": "r6-fda47afab7.wav"
  },
  {
   "id": "r7",
   "part": "6 Reglan og annað dæmi",
   "text": "Og svarið við fyrstu spurningunni?",
   "start": 117.264,
   "end": 119.22,
   "take": "r7-88ce75b2bf.wav"
  },
  {
   "id": "r8",
   "part": "6 Reglan og annað dæmi",
   "text": "Einn fjórði er stærri en einn áttundi. Veldu einn fjórða!",
