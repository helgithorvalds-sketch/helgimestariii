 "title": "Brot: Hvor bitinn er stærri?",
 "sentences": [
  {
   "id": "k1",
   "part": "1 Kveikja",
   "text": "Ímyndaðu þér að þú megir velja.",
   "start": 2.2,
   "end": 4.069,
   "take": "k1-dfdb8bd000.wav"
  },
  {
   "id": "k2",
   "part": "1 Kveikja",
   "text": "Einn fjórði af súkkulaðiplötunni, eða einn áttundi af henni.",
   "start": 4.519,
   "end": 8.322,
   "take": "k2-f28dbc6572.wav"
  },
  {
   "id": "k3",
   "part": "1 Kveikja",
   "text": "Hvort brotið er stærra?",
   "start": 8.772,
   "end": 10.305,
   "take": "k3-9c8e08128d.wav"
  },
  {
   "id": "k4",
   "part": "1 Kveikja",
   "text": "Segðu ágiskun þína upphátt.",
   "start": 10.755,
   "end": 12.717,
   "take": "k4-ddba7aaaba.wav",
   "think_start": 12.967,
   "think_end": 16.467
  },
  {
   "id": "h1",
   "part": "3 Hittu hlutana",
   "text": "Fyrst þurfum við tvö orð.",
   "start": 17.717,
   "end": 19.331,
   "take": "h1-a32f940966.wav"
  },
  {
   "id": "h2",
   "part": "3 Hittu hlutana",
   "text": "Brot hefur tvær tölur, eina uppi og eina niðri.",
   "start": 19.781,
   "end": 22.599,
   "take": "h2-656c341740.wav"
  },
  {
   "id": "h3",
   "part": "3 Hittu hlutana",
   "text": "Neðri talan heitir nefnari.",
   "start": 23.049,
   "end": 24.885,
   "take": "h3-65bc9c9c0d.wav"
  },
  {
   "id": "h4",
   "part": "3 Hittu hlutana",
   "text": "Hún segir í hve marga jafna hluta við skiptum.",
   "start": 25.335,
   "end": 27.823,
   "take": "h4-827b5703d0.wav"
  },
  {
   "id": "h5",
   "part": "3 Hittu hlutana",
   "text": "Efri talan heitir teljari.",
   "start": 28.273,
   "end": 30.061,
   "take": "h5-48256ad77e.wav"
  },
  {
   "id": "h6",
   "part": "3 Hittu hlutana",
   "text": "Hún segir hve marga hluta þú færð.",
   "start": 30.511,
   "end": 32.635,
   "take": "h6-e1aea7bd00.wav"
  },
  {
   "id": "e1",
   "part": "4 Erfiða skrefið",
   "text": "Margir halda að einn áttundi sé stærri.",
   "start": 33.885,
   "end": 36.609,
   "take": "e1-6b058c063f.wav"
  },
  {
   "id": "e2",
   "part": "4 Erfiða skrefið",
   "text": "Átta er jú stærri tala en fjórir.",
   "start": 37.059,
   "end": 39.617,
   "take": "e2-bcf366c26d.wav"
  },
  {
   "id": "e3",
   "part": "4 Erfiða skrefið",
   "text": "En skoðum hvað gerist í raun.",
   "start": 40.067,
   "end": 42.056,
   "take": "e3-fa75623550.wav"
  },
  {
   "id": "e4",
   "part": "4 Erfiða skrefið",
   "text": "Hér eru fjórir vinir sem deila súkkulaðiplötu.",
   "start": 42.506,
   "end": 45.393,
   "take": "e4-7517e30cd7.wav"
  },
  {
   "id": "e5",
   "part": "4 Erfiða skrefið",
   "text": "Hver og einn fær einn fjórða.",
   "start": 45.843,
   "end": 47.608,
   "take": "e5-7bece11d42.wav"
  },
  {
   "id": "e6",
   "part": "4 Erfiða skrefið",
   "text": "Nú koma fjórir vinir í viðbót.",
   "start": 48.058,
   "end": 50.285,
   "take": "e6-4e02791e5d.wav"
  },
  {
   "id": "e7",
   "part": "4 Erfiða skrefið",
   "text": "Þá eru þeir átta, og platan er sú sama.",
   "start": 50.735,
   "end": 53.155,
   "take": "e7-5ebf689fa5.wav"
  },
  {
   "id": "e8",
   "part": "4 Erfiða skrefið",
   "text": "Við skiptum henni í átta jafna hluta.",
   "start": 53.605,
   "end": 55.753,
   "take": "e8-3397427151.wav"
  },
  {
   "id": "e9",
   "part": "4 Erfiða skrefið",
   "text": "Hver og einn fær einn áttunda.",
   "start": 56.203,
   "end": 58.077,
   "take": "e9-b810510da1.wav"
  },
  {
   "id": "e10",
   "part": "4 Erfiða skrefið",
   "text": "Berum bitana saman.",
   "start": 58.527,
   "end": 59.886,
   "take": "e10-95f34a81f3.wav"
  },
  {
   "id": "e11",
   "part": "4 Erfiða skrefið",
   "text": "Einn áttundi er bara helmingurinn af einum fjórða.",
   "start": 60.336,
   "end": 63.504,
   "take": "e11-2491d8a942.wav"
  },
  {
   "id": "e12",
   "part": "4 Erfiða skrefið",
   "text": "Því fleiri sem deila, því minni verður hver biti.",
   "start": 63.954,
   "end": 66.706,
   "take": "e12-6b942f49f7.wav"
  },
  {
   "id": "n1",
   "part": "5 Nú þú",
   "text": "Nú er komið að þér.",
   "start": 68.056,
   "end": 69.298,
   "take": "n1-5097e1bcd9.wav"
  },
  {
   "id": "n2",
   "part": "5 Nú þú",
   "text": "Hvort brotið er stærra: einn þriðji eða einn sjötti?",
   "start": 69.748,
   "end": 73.092,
   "take": "n2-d839c310f7.wav"
  },
  {
   "id": "n3",
   "part": "5 Nú þú",
   "text": "Veldu græna spjaldið eða það bláa, og segðu það upphátt.",
   "start": 73.542,
   "end": 77.186,
   "take": "n3-ca13e2eff2.wav"
  },
  {
   "id": "n4",
   "part": "5 Nú þú",
   "text": "Þú mátt setja á pásu ef þú vilt hugsa lengur.",
   "start": 77.636,
   "end": 80.306,
   "take": "n4-4091b543bd.wav",
   "think_start": 80.556,
   "think_end": 85.056
  },
  {
   "id": "n5",
   "part": "5 Nú þú",
   "text": "Einn þriðji, á græna spjaldinu, er stærri.",
   "start": 85.506,
   "end": 88.953,
   "take": "n5-86a68405f5.wav"
  },
  {
   "id": "n6",
   "part": "5 Nú þú",
   "text": "Ef þú valdir bláa spjaldið, þá ertu í góðum hópi.",
   "start": 89.403,
   "end": 92.419,
   "take": "n6-da9ed6e431.wav"
  },
  {
   "id": "n7",
   "part": "5 Nú þú",
   "text": "Sex er stærri tala, en þegar sex deila verða bitarnir minni.",
   "start": 92.869,
   "end": 96.654,
   "take": "n7-c6fb75270a.wav"
  },
  {
   "id": "r1",
   "part": "6 Reglan og annað dæmi",
   "text": "Þetta er reglan.",
