   "end": 141.832,
   "take": "m4-6c7e8f1226.wav"
  },
  {
   "id": "m5",
   "part": "7 Nú þú aftur",
   "text": "Ef hundrað vinir deila plötunni fær hver og einn pínulítinn mola.",
